# Values for the local stack. For the VM, replace the block "Addresses" and all
# passwords (vm-setup.md, section 4).

# Compose project name (containers, volumes). Locally, an existing stack named
# teamable-local keeps its data if this is set to teamable-local.
COMPOSE_PROJECT_NAME=teamable-dev

# Paths to the checkouts (relative to this folder)
BACKEND_DIR=./teamable-backend
FRONTEND_DIR=./teamable-frontend

# --- Addresses ---
# Host names as used in the browser; URLs without a trailing /
TEAMABLE_HOST=teamable.localhost
TEAMABLE_URL=http://teamable.localhost:8080
MOODLE_HOST=moodle.localhost
MOODLE_URL=http://moodle.localhost:8008
# true when a proxy in front of Moodle terminates TLS (VM)
MOODLE_SSLPROXY=false

# Host ports (only on 127.0.0.1)
TEAMABLE_PORT=8080
MOODLE_PORT=8008

# --- Backend (loaded into the web container via env_file) ---
# TRUE:  SQLite inside the container (lost whenever web is recreated), no check
#        of the LTI deployment ID, ALLOWED_HOSTS = *
# FALSE: Postgres (data stays in the volume), deployment_ids needed in the LTI
#        config, only TEAMABLE_HOST allowed
DEBUG=TRUE
# Only read once settings.py takes it from the environment (production-plan.md, section 4.1)
SECRET_KEY=change-me
CANVAS_BASE_URL=
CANVAS_OAUTH_CLIENT_ID=
CANVAS_OAUTH_CLIENT_SECRET=

# Postgres (used with DEBUG=FALSE)
POSTGRES_DB=teamable
POSTGRES_USER=teamable
POSTGRES_PASSWORD=change-me

# --- Moodle ---
MOODLE_IMAGE=brandkern/moodle:v4.5.4
MOODLE_DB_ROOT_PASSWORD=change-me
MOODLE_DB_PASSWORD=change-me
